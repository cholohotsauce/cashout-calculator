# Copy to .env.local for local development (or run `vercel env pull .env.local`).

# Postgres connection string. Adding Neon from the Vercel Marketplace sets this for you.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# The PIN managers type to open Shift history. Changing it signs everyone out.
MANAGER_PIN=

# Optional: a long random string used to sign manager sessions.
# Falls back to a key derived from DATABASE_URL and MANAGER_PIN.
SESSION_SECRET=
